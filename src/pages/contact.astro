---
import Base from '../layouts/Base.astro';
---
<Base title={"Contact | Embodied Music Pedagogy"} description={"Contact Melissa Bremmer and Luc Nijs about Embodied Music Pedagogy."} path="/contact">
  <div class="contact page-end">
    <h1>Contact Us</h1>
    <form data-contact>
      <div>
        <label for="first">First name</label>
        <input id="first" type="text" name="first" autocomplete="given-name" />
      </div>
      <div>
        <label for="last">Last name</label>
        <input id="last" type="text" name="last" autocomplete="family-name" />
      </div>
      <div class="full">
        <label for="email">Email *</label>
        <input id="email" type="email" name="email" autocomplete="email" required />
      </div>
      <div class="full">
        <label for="message">Write a message</label>
        <textarea id="message" name="message"></textarea>
      </div>
      <div><button type="submit">Submit</button></div>
      <p class="note" data-note hidden></p>
    </form>
  </div>
  <script>
    const TO = 'info@embodiedmusicpedagogy.org';
    const form = document.querySelector<HTMLFormElement>('[data-contact]');
    const note = document.querySelector<HTMLElement>('[data-note]');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = `${data.get('first') ?? ''} ${data.get('last') ?? ''}`.trim();
      const body = [`Name: ${name}`, `Email: ${data.get('email')}`, '', String(data.get('message') ?? '')].join('\n');
      const url = `mailto:${TO}?subject=${encodeURIComponent('via website')}&body=${encodeURIComponent(body)}`;
      if (note) {
        note.hidden = false;
        note.textContent = 'Your email program should open with this message, ready to send. If it doesn’t, ';
        const link = document.createElement('a');
        link.href = url;
        link.textContent = 'open it here';
        note.append(link, ` or write to ${TO}.`);
      }
      window.location.href = url;
    });
  </script>
</Base>
