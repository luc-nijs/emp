---
import Base from '../layouts/Base.astro';
import '../styles/publications.css';
import { SHEET_CSV_URL, SECTION_ORDER, sectionId, recordsFromCSV, listHtml, countText } from '../lib/publications.js';
import snapshot from '../data/publications-snapshot.json';

// The list is written into the page when the site is built, so search engines
// can read it. The browser then refreshes it from the sheet for every visitor.
// If the sheet can't be read during a build, the saved copy keeps the page full.
let records = snapshot;
try {
  const res = await fetch(SHEET_CSV_URL, { signal: AbortSignal.timeout(20000) });
  if (!res.ok) throw new Error('HTTP ' + res.status);
  const fromSheet = recordsFromCSV(await res.text());
  if (!fromSheet.length) throw new Error('no usable rows');
  records = fromSheet;
} catch (err) {
  console.warn('[publications] Using the saved copy: the sheet could not be read.', err);
}
const dataJson = JSON.stringify(records).replace(/</g, '\\u003c');
---
<Base title="Publications | Embodied Music Pedagogy" path="/publications">
  <div class="pub-tabs" id="pb-tabs">
    {SECTION_ORDER.map((s) => <a href={`#${sectionId(s)}`}>{s}</a>)}
  </div>
  <div class="col page-end">
    <div id="pub-app">
      <div class="pb-controls">
        <span><label for="pb-group">Group by</label><select id="pb-group">
          <option value="section">author</option>
          <option value="year">year</option>
          <option value="type">type</option>
          <option value="role">role</option>
        </select></span>
        <span><label for="pb-type">Type</label><select id="pb-type"><option value="">all</option></select></span>
        <span><label for="pb-role">Role</label><select id="pb-role"><option value="">all</option></select></span>
        <span><label for="pb-from">From</label><select id="pb-from"></select>
          <label for="pb-to">to</label><select id="pb-to"></select></span>
        <span><input type="search" id="pb-q" aria-label="Search publications" placeholder="author, title, journal…" size="20"></span>
        <span class="pb-count" id="pb-count">{countText(records)}</span>
      </div>
      <div id="pb-list" set:html={listHtml(records, 'section')}></div>
      <div class="pb-status" id="pb-status"></div>
    </div>
  </div>
  <script id="pb-data" type="application/json" set:html={dataJson}></script>
</Base>

<script>
  import { SHEET_CSV_URL, ROLE_ORDER, ROLE_LABEL, TYPE_ORDER, TYPE_LABEL, esc, listHtml, countText, recordsFromCSV } from '../lib/publications.js';

  const $ = (id) => document.getElementById(id);
  let records = [];

  function applyFilters() {
    const type = $('pb-type').value, role = $('pb-role').value;
    const from = Number($('pb-from').value), to = Number($('pb-to').value);
    const q = $('pb-q').value.trim().toLowerCase();
    const hit = records.filter((r) => {
      if (type && r.type !== type) return false;
      if (role && r.role !== role) return false;
      const y = Number(r.year);
      // Undated and forthcoming items are never filtered out by the year range.
      if (y && (y < from || y > to)) return false;
      if (q && !r._hay.includes(q)) return false;
      return true;
    });
    $('pb-count').textContent = countText(hit);
    $('pb-list').innerHTML = listHtml(hit, $('pb-group').value);
  }

  function addOptions(id, values, labels) {
    for (const v of values) {
      $(id).insertAdjacentHTML('beforeend', '<option value="' + esc(v) + '">' + esc(labels[v] || v) + '</option>');
    }
  }

  function buildControls() {
    const rank = (order) => (a, b) => (order.indexOf(a) + 1 || 99) - (order.indexOf(b) + 1 || 99);
    addOptions('pb-type', [...new Set(records.map((r) => r.type).filter(Boolean))].sort(rank(TYPE_ORDER)), TYPE_LABEL);
    addOptions('pb-role', [...new Set(records.map((r) => r.role).filter(Boolean))].sort(rank(ROLE_ORDER)), ROLE_LABEL);
    const years = records.map((r) => Number(r.year)).filter((y) => y > 1900);
    const lo = Math.min(...years), hi = Math.max(...years);
    for (let y = hi; y >= lo; y--) {
      addOptions('pb-from', [y], {});
      addOptions('pb-to', [y], {});
    }
    $('pb-from').value = lo; $('pb-to').value = hi;
    for (const id of ['pb-group', 'pb-type', 'pb-role', 'pb-from', 'pb-to']) {
      $(id).addEventListener('change', applyFilters);
    }
    $('pb-q').addEventListener('input', applyFilters);
  }

  function start(list, note) {
    records = list.map((r) => ({
      ...r,
      _hay: [r.authors, r.title, r.venue, r.type, r.role, r.status, r.year, r.language, r.doi, r.section]
        .filter(Boolean).join(' ').toLowerCase(),
    }));
    buildControls();
    applyFilters();
    $('pb-status').textContent = note;
    // The list was redrawn, so go back to the part named in the address.
    if (location.hash) document.getElementById(location.hash.slice(1))?.scrollIntoView();
  }

  // The three buttons jump to a part of the list, which only exists when
  // grouping by author: switch back to that first.
  $('pb-tabs').addEventListener('click', () => {
    if ($('pb-group').value !== 'section') {
      $('pb-group').value = 'section';
      applyFilters();
    }
  });

  // Cache-bust per minute so a sheet edit is not masked by a stale copy.
  fetch(SHEET_CSV_URL + '&v=' + Math.floor(Date.now() / 60000), { cache: 'no-cache' })
    .then((res) => { if (!res.ok) throw new Error('HTTP ' + res.status); return res.text(); })
    .then((text) => {
      const fromSheet = recordsFromCSV(text);
      if (!fromSheet.length) throw new Error('no usable rows');
      start(fromSheet, 'Use the filters above, or search by author, title or journal.');
    })
    .catch(() => {
      // Sheet unreachable or unusable: keep the list that was built into the page.
      start(JSON.parse($('pb-data').textContent), 'Showing the saved list — the live sheet could not be read.');
    });
</script>
