---
import '../styles/site.css';
import { nav } from '../data/nav.js';

interface Props { title: string; description?: string; path: string; heading?: string; noindex?: boolean }
const { title, description = '', path, heading, noindex = false } = Astro.props;

const site = Astro.site ?? 'https://www.embodiedmusicpedagogy.org';
const canonical = new URL(path === '/' ? '/' : `${path}/`, site).href;
const ogImage = new URL('/images/og-emp.jpg', site).href;
const siteData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Embodied Music Pedagogy',
  url: new URL('/', site).href,
  description: 'A research-based framework for music learning and teaching, developed by Melissa Bremmer and Luc Nijs.',
  author: [
    {
      '@type': 'Person',
      name: 'Melissa Bremmer',
      worksFor: { '@type': 'CollegeOrUniversity', name: 'Amsterdam University of the Arts' },
      sameAs: ['https://www.ahk.nl/lectoraten/educatie/onderzoeksgroep/melissa-bremmer/'],
    },
    {
      '@type': 'Person',
      name: 'Luc Nijs',
      worksFor: { '@type': 'CollegeOrUniversity', name: 'University of Luxembourg' },
      sameAs: ['https://www.uni.lu/fhse-en/people/luc-nijs/'],
    },
  ],
};

// A page in a dropdown keeps its parent highlighted, as on the Wix site.
const isOn = (item) => item.href === path || (item.children ?? []).some((c) => c.href === path);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Embodied Music Pedagogy" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Luc Nijs and Melissa Bremmer" />
    <meta name="twitter:card" content="summary_large_image" />
    {(path === '/' || path === '/about') && <script type="application/ld+json" set:html={JSON.stringify(siteData).replace(/</g, '\\u003c')} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Manrope:wght@300..700&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <header class="top">
      <div class="top-in">
        <a class="site-title" href="/">Embodied Music Pedagogy</a>
        <nav aria-label="Main">
          <ul class="menu">
            {nav.map((item) => (
              <li class={item.children ? 'has-sub' : ''}>
                <a href={item.href} class={isOn(item) ? 'on' : ''}>{item.label}</a>
                {item.children && (
                  <ul class="sub">
                    {item.children.map((c) => <li><a href={c.href} class={c.href === path ? 'on' : ''}>{c.label}</a></li>)}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main>{heading && <h1 class="sr-only">{heading}</h1>}<slot /></main>
    <footer>
      <div class="logos">
        <img class="logo-aua" src="/images/logo-aua.png" alt="Amsterdam University of the Arts" width="69" height="55" />
        <img class="logo-unilu" src="/images/logo-unilu.png" alt="University of Luxembourg" width="91" height="55" />
      </div>
      <p class="copy">© 2024 by Luc Nijs &amp; Melissa Bremmer</p>
    </footer>
  </body>
</html>
